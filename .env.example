# =============================================================================
# GegoK12 / Laravel — copy to .env or set the same keys in Coolify
# Defaults match docker-compose.yml where possible.
# =============================================================================

# --- App ---
APP_NAME=GegoK12
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gegok.trilolabs.com
TIMEZONE=Asia/Kolkata
DEBUGBAR_ENABLED=false
LOG_CHANNEL=daily
LOG_SLACK_WEBHOOK_URL=

# --- Database (in Docker, DB_HOST must be "db") ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=school
DB_USERNAME=root
DB_PASSWORD=root
DB_SOCKET=
MYSQL_USER=laravel
MYSQL_PASSWORD=root

# Compose host ports
APP_PORT=8090
PHPMYADMIN_PORT=8092

# --- Drivers ---
BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync
QUEUE_DRIVER=sync
FILESYSTEM_DISK=uploads
FILESYSTEM_DRIVER=local

# --- Redis (optional) ---
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
MAIL_MAILER=smtp
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=admin@school.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_STATUS=off
REMINDER=mail

# --- SMS ---
SMS_GATEWAY=MSG91
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=
SMS_GATEWAY_ROUTE_NO=4
SMS_STATUS=off
REMINDER_API_KEY=
REMINDER_SENDER_ID=
REMINDER_ROUTE_NO=4

# --- Push / FCM / Firebase ---
FCM_SERVER_KEY=
FCM_SENDER_ID=
FCM_TEACHER_SERVER_KEY=
FCM_TEACHER_SENDER_ID=
FCM_PROTOCOL=http
FIREBASE_CREDENTIALS=
TEACHER_FIREBASE_CREDENTIALS=
FIREBASE_PROJECT=app
GOOGLE_APPLICATION_CREDENTIALS=

# --- Pusher ---
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_KEY=
AWS_SECRET=

# --- reCAPTCHA (empty = captcha disabled on register) ---
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

# --- Scout / Algolia ---
SCOUT_DRIVER=null
SCOUT_QUEUE=false
SCOUT_PREFIX=
ALGOLIA_APP_ID=
ALGOLIA_SECRET=

# --- Twilio / Maps / Addons ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_KEY=
TWILIO_SECRET=
GOOGLE_MAPS_API_KEY=
ADDON_API_URL=

# --- App tuning ---
CACHE_TIME=8400
SNOOZE_TIME=600
ACTIVITY_LOGGER_ENABLED=true
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,gegok.trilolabs.com
AIRLOCK_STATEFUL_DOMAINS=localhost

# --- Optional third-party ---
MAILGUN_DOMAIN=
MAILGUN_SECRET=
SES_KEY=
SES_SECRET=
SES_REGION=us-east-1
SPARKPOST_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
